digraph G { rankdir=BT; graph [bgcolor="transparent",pad=0.2,nodesep=0.25,ranksep=0.35]; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#2F5D7C",fontname="DejaVu Sans",fontsize=10,width=4.2]; edge [color="#567A93"];A[label="0.1 Projektkatalog"];B[label="0.2 Status & Review"];C[label="0.3 Anforderungen & Referenzen"];D[label="0.4 Suche, Audit & Export"];E[label="0.5 MVP: Backup, Restore, Hardening",fillcolor="#D5F5E3"];F[label="0.6 Governanceobjekte"];G[label="0.7 Produktbezug"];H[label="0.8 bis 1.0 Stabilisierung & Freigabe",fillcolor="#D6EAF8"];A->B->C->D->E->F->G->H;}