# SASD PIMS — project-local high-autonomy Codex rules
#
# Install in the repository as:
#   <repo>/.codex/rules/pims.rules
#
# The repository .codex layer must be trusted for project-local rules to load.
#
# Intent:
# - Codex may carry an entire PIMS milestone through build/test/debug/commit/push
#   without repeatedly waiting for approval;
# - destructive/history-rewriting/credential/admin operations still stop;
# - AGENTS.md remains the semantic/governance boundary.
#
# This file is intentionally generous because SASD PIMS is a trusted repository.
# Codex uses the most restrictive matching rule across global + project rules.

# ---------------------------------------------------------------------------
# Broad PIMS autonomy
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["dotnet"],
    decision = "allow",
    justification = "PIMS authorizes autonomous .NET development, migration, test, run, package and tooling commands within the trusted project.",
)

prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "PIMS authorizes normal autonomous Git work including staging, commits, branches, merges and normal pushes.",
)

prefix_rule(
    pattern = ["gh"],
    decision = "allow",
    justification = "PIMS authorizes routine GitHub CLI work including PR creation, CI checks and release preparation.",
)

# ---------------------------------------------------------------------------
# .NET exceptions — keep genuinely destructive/security-sensitive operations explicit
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "Dropping any PIMS database is destructive.",
)

prefix_rule(
    pattern = ["dotnet", "nuget", ["push", "delete", "sign", "trust"]],
    decision = "prompt",
    justification = "Publishing/deleting/signing packages or changing NuGet trust affects external/security-sensitive state.",
)

prefix_rule(
    pattern = ["dotnet", "nuget", ["add", "remove", "update", "enable", "disable"], "source"],
    decision = "prompt",
    justification = "Changing NuGet sources changes package provenance and may affect credentials/supply-chain trust.",
)

prefix_rule(
    pattern = ["dotnet", "workload", ["install", "update", "uninstall", "repair"]],
    decision = "prompt",
    justification = "Changing .NET workloads modifies the SDK installation and can be large/system-wide.",
)

prefix_rule(
    pattern = ["dotnet", "user-secrets"],
    decision = "prompt",
    justification = "User-secrets commands can access or modify sensitive local secret material.",
)

prefix_rule(
    pattern = ["dotnet", "dev-certs"],
    decision = "prompt",
    justification = "Development-certificate commands can modify the local certificate store.",
)

prefix_rule(
    pattern = ["dotnet", "exec"],
    decision = "prompt",
    justification = "dotnet exec can launch an arbitrary managed assembly outside the normal project workflow.",
)

# Note: dotnet tool install/update/uninstall and dotnet new template operations
# are intentionally allowed in PIMS to avoid unnecessary blocking. AGENTS.md
# still requires dependency/tool additions to be justified and reviewed in code.

# ---------------------------------------------------------------------------
# Git exceptions — protect work and shared history
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["git", ["reset", "clean", "rebase", "restore", "filter-branch", "update-ref", "replace"]],
    decision = "prompt",
    justification = "This Git operation can discard work, rewrite history or alter refs.",
)

prefix_rule(
    pattern = ["git", "checkout", ["--", "-f", "--force"]],
    decision = "prompt",
    justification = "This checkout form can overwrite or discard working-tree content.",
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Amending a commit rewrites history.",
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "prompt",
    justification = "Deleting a branch requires explicit approval.",
)

prefix_rule(
    pattern = ["git", "tag", "-d"],
    decision = "prompt",
    justification = "Deleting a tag requires explicit approval.",
)

prefix_rule(
    pattern = ["git", "stash", ["drop", "clear"]],
    decision = "prompt",
    justification = "Dropping or clearing stash entries can permanently discard recoverable work.",
)

prefix_rule(
    pattern = ["git", "reflog", "expire"],
    decision = "prompt",
    justification = "Expiring reflog entries removes recovery information.",
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Removing a worktree can discard files if used incorrectly.",
)

prefix_rule(
    pattern = ["git", "switch", ["-C", "--discard-changes"]],
    decision = "prompt",
    justification = "This switch form can reset a branch or discard working-tree changes.",
)

prefix_rule(
    pattern = ["git", "remote", ["add", "remove", "rename", "set-url"]],
    decision = "prompt",
    justification = "Changing PIMS remotes can redirect fetch/push traffic.",
)

prefix_rule(
    pattern = ["git", "config", ["--global", "--system"]],
    decision = "prompt",
    justification = "Changing global/system Git configuration affects more than PIMS.",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror", "--prune"]],
    decision = "prompt",
    justification = "This push form can rewrite or delete remote refs/history.",
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror", "--prune"]],
    decision = "prompt",
    justification = "This push to origin can rewrite or delete PIMS remote refs/history.",
)

# ---------------------------------------------------------------------------
# GitHub exceptions — milestone automation is allowed; admin/destructive boundaries remain
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "forbidden",
    justification = "Do not print the GitHub token into Codex output. Use 'gh auth status'.",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "gh api can perform arbitrary GitHub API operations, including destructive writes.",
)

prefix_rule(
    pattern = ["gh", "repo", ["create", "delete", "archive", "rename", "transfer", "edit"]],
    decision = "prompt",
    justification = "This operation creates, deletes or materially changes GitHub repository administration.",
)

# PR creation/checks are intentionally automatic; the final merge to main remains a human gate.
prefix_rule(
    pattern = ["gh", "pr", ["merge", "close"]],
    decision = "prompt",
    justification = "Merging or closing a PIMS pull request changes the accepted shared integration state.",
)

prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "prompt",
    justification = "Deleting a PIMS release is destructive.",
)

prefix_rule(
    pattern = ["gh", "run", ["cancel", "delete"]],
    decision = "prompt",
    justification = "Cancelling or deleting GitHub Actions runs changes shared CI evidence/state.",
)

prefix_rule(
    pattern = ["gh", "workflow", ["disable", "enable"]],
    decision = "prompt",
    justification = "Changing workflow enablement modifies PIMS repository automation.",
)

prefix_rule(
    pattern = ["gh", "secret"],
    decision = "prompt",
    justification = "GitHub secret operations involve sensitive shared configuration.",
)

prefix_rule(
    pattern = ["gh", "variable"],
    decision = "prompt",
    justification = "GitHub variable operations alter shared configuration.",
)

prefix_rule(
    pattern = ["gh", "auth", ["login", "logout", "refresh", "switch", "setup-git"]],
    decision = "prompt",
    justification = "Changing GitHub authentication or Git credential integration requires explicit approval.",
)

prefix_rule(
    pattern = ["gh", "config", "set"],
    decision = "prompt",
    justification = "Changing GitHub CLI configuration can affect future operations outside the milestone.",
)

prefix_rule(
    pattern = ["gh", "extension", ["install", "upgrade", "remove"]],
    decision = "prompt",
    justification = "Changing GitHub CLI extensions alters executable third-party tooling.",
)

prefix_rule(
    pattern = ["gh", "gist", "delete"],
    decision = "prompt",
    justification = "Deleting a gist is destructive.",
)

prefix_rule(
    pattern = ["gh", "project", "delete"],
    decision = "prompt",
    justification = "Deleting a GitHub Project is destructive.",
)
